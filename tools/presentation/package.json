{
  "name": "@sts-simulator/presentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "SpireSim display names, localized messages and recorded-game viewer",
  "exports": {
    ".": "./index.mjs",
    "./catalogs": "./catalogs.mjs",
    "./original-names": "./original-names.json",
    "./original-card-text": "./original-card-text.json",
    "./original-event-text": "./original-event-text.json",
    "./locales/*.json": "./locales/*.json"
  },
  "files": ["index.mjs", "catalogs.mjs", "original-names.json", "original-card-text.json", "original-event-text.json", "locales/*.json", "replay/*", "!replay/*.test.mjs", "README.md"],
  "scripts": {
    "test": "node --test localization.test.mjs replay/sequence.test.mjs replay/journey.test.mjs replay/recording.test.mjs replay/build.test.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "i18next": "26.5.4" },
  "devDependencies": { "esbuild": "0.28.2" }
}
